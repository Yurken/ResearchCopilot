{
  "name": "research-copilot",
  "version": "0.5.3",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@research-copilot/web",
    "dev:desktop": "pnpm --dir apps/desktop run dev",
    "build:web": "turbo run build --filter=@research-copilot/web",
    "build:desktop": "pnpm --dir apps/desktop run tauri build",
    "build:desktop:with-dsh": "pnpm dsh:prepare-runtime && pnpm --dir apps/desktop run tauri build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "pnpm --dir apps/desktop run test:e2e",
    "eval:paper-search:prepare": "uv run --with pyarrow python scripts/paper-search-eval/prepare_dataset.py",
    "eval:paper-search:gold": "python3 scripts/paper-search-eval/prepare_gold_metadata.py",
    "eval:paper-search:stratify": "python3 scripts/paper-search-eval/select_stratified_sample.py",
    "eval:paper-search:test": "python3 -m unittest discover -s scripts/paper-search-eval -p 'test_*.py'",
    "eval:paper-search:plan": "python3 scripts/paper-search-eval/run_plan_eval.py",
    "eval:paper-search:litsearch": "python3 scripts/paper-search-eval/run_litsearch.py",
    "eval:paper-search:paired": "python3 scripts/paper-search-eval/run_paired_litsearch.py",
    "eval:paper-search:compare": "python3 scripts/paper-search-eval/compare_litsearch_reports.py",
    "eval:paper-search:snippets": "python3 scripts/paper-search-eval/probe_snippet_search.py",
    "eval:paper-search:inspect": "python3 scripts/paper-search-eval/inspect_gold.py",
    "eval:core-agent": "python3 scripts/core-agent-eval/run_core_gates.py",
    "eval:core-agent:test": "python3 -m unittest discover -s scripts/core-agent-eval -p 'test_*.py'",
    "dsh:verify-pin": "node scripts/prepare-dsh-runtime.mjs --verify-only",
    "dsh:prepare-runtime": "node scripts/prepare-dsh-runtime.mjs",
    "dsh:prepare-runtime:dev": "node scripts/prepare-dsh-runtime.mjs --use-current-node",
    "codex:verify-pin": "node scripts/prepare-codex-runtime.mjs --verify-only",
    "codex:prepare-runtime": "node scripts/prepare-codex-runtime.mjs",
    "opencode:verify-pin": "node scripts/prepare-opencode-runtime.mjs --verify-only",
    "opencode:prepare-runtime": "node scripts/prepare-opencode-runtime.mjs",
    "pi-web:verify-pin": "node scripts/prepare-pi-web-runtime.mjs --verify-only",
    "pi-web:prepare-runtime": "node scripts/prepare-pi-web-runtime.mjs",
    "pi-web:prepare-runtime:dev": "node scripts/prepare-pi-web-runtime.mjs --use-current-node",
    "harness:sources:init": "git submodule update --init --recursive vendor/deepseek-harness vendor/codex-harness vendor/opencode-harness vendor/pi-harness vendor/pi-web",
    "harness:sources:update": "git submodule update --remote --checkout vendor/deepseek-harness vendor/codex-harness vendor/opencode-harness vendor/pi-harness vendor/pi-web",
    "tauri": "pnpm --dir apps/desktop run tauri",
    "deploy:all": "node scripts/release-sync-landing.mjs --deploy-all",
    "release:landing": "node scripts/release-sync-landing.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "turbo": "^2.10.11"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
